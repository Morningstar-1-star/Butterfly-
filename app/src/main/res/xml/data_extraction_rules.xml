<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="supabase_auth_prefs.xml" />
        <exclude domain="sharedpref" path="butterfly_vault_prefs.xml" />
        <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
        <exclude domain="database" path="webview.db" />
        <exclude domain="database" path="webviewCache.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="supabase_auth_prefs.xml" />
        <exclude domain="sharedpref" path="butterfly_vault_prefs.xml" />
        <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
        <exclude domain="database" path="webview.db" />
        <exclude domain="database" path="webviewCache.db" />
    </device-transfer>
</data-extraction-rules>
