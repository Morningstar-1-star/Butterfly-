<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer sleek geometric shield background glow -->
    <path android:pathData="M54,26 L78,38 L78,66 L54,82 L30,66 L30,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="26"
                android:endX="78"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#2AE91E63" />
                <item android:offset="1.0" android:color="#2A9C27B0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer shield border -->
    <path
        android:pathData="M54,26 L78,38 L78,66 L54,82 L30,66 L30,38 Z"
        android:strokeWidth="2.5"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="26"
                android:endX="78"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF2196F3" />
                <item android:offset="0.5" android:color="#FFE91E63" />
                <item android:offset="1.0" android:color="#FF9C27B0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Play Triangle -->
    <path android:pathData="M46,40 L68,54 L46,68 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="46"
                android:startY="40"
                android:endX="68"
                android:endY="68"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFF3D00" />
                <item android:offset="0.5" android:color="#FFE91E63" />
                <item android:offset="1.0" android:color="#FFD500F9" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top-left play shine overlay -->
    <path
        android:pathData="M46,40 L68,54 L46,54 Z"
        android:fillColor="#30FFFFFF" />
</vector>
