# GEMINI_API_KEY: Required for Gemini AI API calls.
# Users configure keys via the Secrets panel in the AI Studio UI.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# YOUTUBE_API_KEY: YouTube Data API v3 key for YouTube discovery/search/metadata
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# TMDB & Metadata API Keys (configured via AI Studio Secrets panel)
TMDB_API_KEY=YOUR_TMDB_API_KEY_HERE
TMDB_BEARER_TOKEN=YOUR_TMDB_BEARER_TOKEN_HERE
WATCHMODE_API_KEY=YOUR_WATCHMODE_API_KEY_HERE

# Subtitle Provider API Keys
SUBDL_API_KEY=YOUR_SUBDL_API_KEY_HERE
OPENSUBTITLES_API_KEY=YOUR_OPENSUBTITLES_API_KEY_HERE

# Butterfly-MediaServer URL
VEGA_SERVER_URL=https://butterfly-mediaserver-1.onrender.com
